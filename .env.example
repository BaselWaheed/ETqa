# Copy to .env (never commit .env). All values are read by config/settings/base.py.
DJANGO_SETTINGS_MODULE=config.settings.dev
ETQA_SECRET_KEY=change-me-to-a-long-random-string
ETQA_DEBUG=true
ETQA_ALLOWED_HOSTS=127.0.0.1,localhost
ETQA_DATABASE_URL=postgres://etqa:etqa@127.0.0.1:5432/etqa
ETQA_FILE_ROOT=./media
ETQA_LOG_DIR=./logs
ETQA_SESSION_IDLE_MINUTES=60
ETQA_SESSION_ABSOLUTE_HOURS=8
ETQA_LOGIN_MAX_FAILURES=5
ETQA_LOGIN_LOCK_MINUTES=15
# Set to true only when a TLS terminator sits in front of Waitress (ADR-03).
ETQA_BEHIND_TLS_PROXY=false
